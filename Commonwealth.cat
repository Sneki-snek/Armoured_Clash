    <selectionEntry name="Boons and bonuses" id="2db4-193f-4320-0428" hidden="false" import="true" sortIndex="0" type="upgrade">
      <categoryLinks>
        <categoryLink name="Boons" id="9e3e-bea1-17f7-8e4c" hidden="false" primary="true" targetId="9588-4200-697f-615f"/>
      </categoryLinks>
      <selectionEntries>
        <selectionEntry name="Forlorn Hope" id="3f93-51d3-2d6b-3d71" hidden="false" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="329b-1fc3-4509-1f19" automatic="false" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="15"/>
          </costs>
          <profiles>
            <profile name="Forlorn Hope" id="7469-c5c2-fc47-cff3" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">A single unit in the General’s Force that has been deployed at the start of the Clash gains the Vanguard (X”) special rule, with an (X) value 2” higher than its Speed. (For example, a unit with Speed 6” would gain the Vanguard (8”) special rule).
 If the chosen unit already has the Vanguard (X ) special rule it uses the highest (X) value of the two available.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ready For Anything" id="c2df-d05f-e23e-b7f5" hidden="false" import="true" sortIndex="3" type="upgrade">
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="20"/>
          </costs>
          <profiles>
            <profile name="Ready For Anything" id="8a58-25fd-8b1f-7b84" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">A single unit in the General’s Force that has been deployed at the start of the Clash begins the Clash with the On Lookout status.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Countercharge" id="24c9-7a5c-1ec2-7a5b" hidden="false" import="true" sortIndex="5" type="upgrade">
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="30"/>
          </costs>
          <profiles>
            <profile name="Countercharge" id="41cd-c298-68c3-bb7b" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">Once per Round, the General can issue this Special Command to one of their units that has the On Lookout status, in place of declaring Opportunity Fire.


If the Command is successfully issued, the unit immediately makes a Charge manoeuvre, ending in contact with the active enemy unit.


This unit then immediately makes a Close Quarters Attack. (The active enemy unit can Retaliate as normal, if it has a Melee attack.) After doing so, this unit loses its On Lookout status.




Note: This effectively counts as declaring Opportunity Fire, meaning that a General cannot use this Special Command and Opportunity Fire in the same turn.
 
If the unit is unable to end its Charge manoeuvre in contact with the active enemy unit, this Special Command cannot be issued.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Headstrong Commander" id="2f28-1efe-8dec-0009" hidden="false" import="true" sortIndex="6" type="upgrade">
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="45"/>
          </costs>
          <profiles>
            <profile name="Headstrong Commander" id="8f00-0a52-07cb-c724" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">During the Draw Cards step of the Ready Phase this Force’s General may draw up to one more card than the allowed Hand Limit for the clash.
Once these cards have been drawn the General then selects one card and discards it.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Oprichnina Agent" id="8479-ab4f-a755-8d58" hidden="false" import="true" sortIndex="4" type="upgrade">
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="25"/>
          </costs>
          <profiles>
            <profile name="Oprichnina Agent" id="00d0-d609-da5d-7628" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">Once per Round, when a Commonwealth Infantry or Cavalry unit in this Force fails a Discipline Test, its General may choose to pass this test instead.


Its Officer model is immediately Destroyed and the unit gains the Disordered status due to Loss of an Officer.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Seismic Primanka" id="f2d3-a911-5b65-a4a9" hidden="false" import="true" sortIndex="7" type="upgrade">
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="50"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="fad5-a688-0465-b899" field="selections" includeChildSelections="false" scope="force" shared="true" type="lessThan" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Seismic Primanka" id="5866-36f9-e782-33b7" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">If this Force contains at least one Subterranean unit, its General may, after all units have been deployed, deploy an additional Subterranean Marker.


Once all Subterranean units in the General’s army have arrived from Reserve, the remaining Subterranean Marker is immediately removed from play.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Battlegroup Bonus:" id="99cb-5e8f-4ddc-96c6" hidden="false" import="true" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="c25a-9139-f7a3-cfc8" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b6d3-2349-dd92-e369" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="name" type="append" value="Legacy Of The Khans">
              <conditions>
                <condition childId="3813-f906-8fb4-bba5" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="name" type="append" value="The Deluge">
              <conditions>
                <condition childId="6da9-8821-9946-ba3a" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="name" type="append" value="Grim Resolve">
              <conditions>
                <condition childId="9720-ada4-14a9-5282" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Grim Resolve (Command)" id="9e20-9622-5577-9c44" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">This Battlegroup’s General can issue this Special Command to a Commonwealth unit at the end of a Close Quarters Combat.


If the command is successfully issued, this Close Quarters Combat ends in a Stalemate, regardless of the number of models destroyed in each unit.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="9720-ada4-14a9-5282" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="The Deluge" id="e008-5939-1372-6d97" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">After a Commonwealth unit in this Force has rolled the dice for a Close Quarters Attack targeting a unit with the Suppressed status, its General may re-roll any dice showing a Blank result.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="6da9-8821-9946-ba3a" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="Legacy Of The Khans" id="0d4a-3e03-4004-81f5" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">When a Commonwealth unit in this Force with the Hit and Run (X”) special rule finishes its Attack Step, its General may choose to discard a Command &amp; Conquest Card from their hand.


If they do so, X is treated as a number of inches equal to the unit’s Speed value for the duration of this Activation.


A unit can benefit from this Commander Bonus even if it is on On Lookout, and does not lose the On Lookout status if it makes this manoeuvre.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="3813-f906-8fb4-bba5" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>

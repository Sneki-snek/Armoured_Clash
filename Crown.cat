            <selectionEntry name="Ranged (Light)" id="32e3-b847-9773-2322" hidden="false" import="true" sortIndex="1" type="upgrade">
              <constraints>
                <constraint id="bedc-64b7-f8dd-18e2" automatic="true" field="selections" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="9c07-2502-dcd4-e133" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Ranged (Light)" id="5b8e-696a-1ea6-1dbf" hidden="false" typeId="344a-022d-aebf-7e7a" typeName="Type">

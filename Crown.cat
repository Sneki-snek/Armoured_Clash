    <selectionEntry name="Boons and bonuses" id="ea85-8706-fbf8-32c6" hidden="false" import="true" sortIndex="0" type="upgrade">
      <categoryLinks>
        <categoryLink name="Boons" id="8339-8272-b81e-3bd5" hidden="false" primary="true" targetId="9588-4200-697f-615f"/>
      </categoryLinks>
      <selectionEntries>
        <selectionEntry name="Forlorn Hope" id="85e3-0e67-c8d8-3832" hidden="false" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="2bd0-21d7-f152-b6d3" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="15"/>
          </costs>
          <profiles>
            <profile name="Forlorn Hope" id="3562-2eed-2eec-4f66" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">A single unit in the General’s Force that has been deployed at the start of the Clash gains the Vanguard (X”) special rule, with an (X) value 2” higher than its Speed. (For example, a unit with Speed 6” would gain the Vanguard (8”) special rule.)
If the chosen unit already has the Vanguard (X) special rule it uses the highest (X) value of the two available.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ready For Anything" id="16df-9ca4-8194-fddf" hidden="false" import="true" sortIndex="5" type="upgrade">
          <constraints>
            <constraint id="246e-7029-c2aa-5148" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="20"/>
          </costs>
          <profiles>
            <profile name="Ready For Anything" id="5966-c2e3-7692-ca57" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">A single unit in the General’s Force that has been deployed at the start of the Clash begins the Clash with the On Lookout status.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Countercharge" id="09dd-fb02-fe7f-4261" hidden="false" import="true" sortIndex="6" type="upgrade">
          <constraints>
            <constraint id="6987-bebb-7323-b132" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="30"/>
          </costs>
          <profiles>
            <profile name="Countercharge" id="f7cf-62f7-dd52-7c35" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">Once per Round, the General can issue this Special Command to one of their units that has the On Lookout status, in place of declaring Opportunity Fire.


If the Command is successfully issued, the unit immediately makes a Charge manoeuvre, ending in contact with the active enemy unit.


This unit then immediately makes a Close Quarters Attack. (The active enemy unit can Retaliate as normal, if it has a Melee attack.) After doing so, this unit loses its On Lookout status.




Note: This effectively counts as declaring Opportunity Fire, meaning that a General cannot use this Special Command and Opportunity Fire in the same turn.
 
If the unit is unable to end its Charge manoeuvre in contact with the active enemy unit, this Special Command cannot be issued.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Headstrong Commander" id="2d67-e9a8-4635-9e68" hidden="false" import="true" sortIndex="8" type="upgrade">
          <constraints>
            <constraint id="5164-244c-f38c-5af7" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="45"/>
          </costs>
          <profiles>
            <profile name="Headstrong Commander" id="8f0c-420c-7db4-96ed" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">During the Draw Cards step of each Ready Phase, after drawing cards from their Command &amp; Conquest deck, the General can choose to draw one additional card and add it to their Hand.
If they do, they must then discard one card from their Hand.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mad Minute" id="c60d-548b-6112-9e5e" hidden="false" import="true" sortIndex="4" type="upgrade">
          <constraints>
            <constraint id="f02f-91f8-a9dd-6084" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="20"/>
          </costs>
          <profiles>
            <profile name="Mad Minute" id="3a3a-6b4f-28de-c5dd" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">Once per Round, before rolling the Attack Pool for an Infantry unit that is targeting a Light enemy unit, the General can issue this Special Command to the attacking unit.


If the Command is successfully issued, add 4 dice to the Attack Pool.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Standard Of Albion" id="9176-d900-8b83-718f" hidden="false" import="true" sortIndex="7" type="upgrade">
          <constraints>
            <constraint id="6819-7499-74d1-54c0" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="40"/>
          </costs>
          <profiles>
            <profile name="The Standard Of Albion" id="e89a-5eec-6d8f-aad4" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">Once per Round, the General can issue this Special Command to a Crown Commander unit that is not a Behemoth, at the start of its Activation.


If the Command is successfully issued, the unit gains the Inspiring (2) special rule for the duration of its Activation.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Battlegroup Bonus:" id="68a3-9b8c-db1a-a445" hidden="false" import="true" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="df2d-a217-d9e3-34f0" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7f62-e3b3-9c53-7ccd" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="name" type="append" value="Lionhearted">
              <conditions>
                <condition childId="f353-6a14-0887-e50c" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="name" type="append" value="Line Breaker">
              <conditions>
                <condition childId="df41-804b-08d3-4196" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="name" type="append" value="Gun Lugger">
              <conditions>
                <condition childId="49f7-b3f5-f33b-afd7" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="name" type="append" value="None">
              <conditions>
                <condition childId="a809-8976-9c8a-3a13" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Lionhearted" id="5310-fb62-202a-e4ac" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">When making a Discipline Test for a Crown unit, this Battlegroup’s General can choose to discard a Command &amp; Conquest Card from their hand instead of drawing a card from the deck.


The Value of the discarded card is used, as though it was the value of the drawn card.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="f353-6a14-0887-e50c" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="Line Breakers (Command)" id="65d4-5a14-38b4-4261" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">This Battlegroup’s General can issue this Special Command to a Crown Armour unit at the start of the End Phase.


If the command is successfully issued, the unit can control a Strategic Objective for the duration of the phase, as though it were an Infantry or Cavalry unit.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="df41-804b-08d3-4196" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="Gun Luggers (Command)" id="4172-e8e6-c0b2-7a84" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">This Battlegroup’s General can issue this Special Command to a Crown Field Gun unit at the start of its Activation. 
If the Command is successfully issued, the unit gains the Stalkers special rule for the duration of this Activation.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="49f7-b3f5-f33b-afd7" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="None" id="fd4b-11b5-ff3a-fb12" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">Unlike most Battlegroups, the Crown Super-Heavy Auxiliary Battlegroup does not have a Commander, or a Commander Bonus.


This is intentional!</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="a809-8976-9c8a-3a13" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="Wrath of the Raj" id="d6a8-9f2d-22ad-67cf" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">**Once per Round**
Immediately after a friendly Crown Infantry unit resolves an Attack Roll, this General can
choose for the active unit to make a Discipline Test. If this test is successful, this unit can immediately make a
Ranged Attack against an enemy unit within Short Range. This attack is always Weakened. The targeted unit
can be the same as the initial attack or another enemy unit.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="157c-2178-2e2b-6a70" childName="Indian Raj Aux Battlegroup" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pre-Planned Defence" id="ecaf-4ce7-df58-28f9" hidden="false" import="true" sortIndex="3" type="upgrade">
          <constraints>
            <constraint id="3a74-fee2-dbcd-0e6e" automatic="true" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Points" typeId="e58e-982d-7630-5342" value="15"/>
          </costs>
          <profiles>
            <profile name="Pre-Planned Defence" id="d5d6-d76e-1b9f-cd8f" hidden="false" typeId="3f77-4198-5794-9684" typeName="Boons">
              <characteristics>
                <characteristic name="Effect" typeId="b7f2-49d8-a49a-0b0f">When rolling a Forward Pool (see Forward in the Glossary of Special Rules &amp; Qualities), this General may re-roll any Blank or Miss results, provided their force contains at least one Royal Engineer Sapper unit. The original result is disregarded, and only the re-rolled result applies.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>

        <categoryLink name="Infantry (c)" id="b9f9-9322-8ed3-4965" primary="false" targetId="2d10-727d-0cfb-9c0f"/>
        <categoryLink name="Teutonic" id="a451-d9a0-6b39-8abb" hidden="false" primary="false" targetId="9ae0-923c-a4aa-1a7b"/>
        <categoryLink name="Unique" id="40d6-2b08-94cc-22ad" hidden="false" primary="false" targetId="19f4-cd18-0cc2-f95d"/>
      </categoryLinks>
      <constraints>
        <constraint id="c675-82dd-25af-3626" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>

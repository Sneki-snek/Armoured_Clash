      </constraints>
      <entryLinks>
        <entryLink name="Basic Arm/Art" id="4b1b-5a13-b4b1-f84a" hidden="false" import="true" sortIndex="1" targetId="0b8e-b745-ef0c-4acb" type="selectionEntry"/>
        <entryLink name="Reinforced Arm/Art" id="1ab1-242e-4174-8b32" hidden="false" import="true" sortIndex="2" targetId="9124-ea78-0445-af38" type="selectionEntry"/>
        <entryLink name="Full Strength Arm/Art" id="6f06-0ec8-c22b-fee6" hidden="false" import="true" sortIndex="3" targetId="0447-bc45-62e6-b99c" type="selectionEntry"/>
